{
  "name": "zsb-study-tracker",
  "private": true,
  "version": "2.0.3-beta.1",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "专升本学习打卡管理助手（Web + 桌面端）",
  "author": "Han050912",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "npm run build:desktop && electron-builder",
    "dist:win": "npm run build:desktop && electron-builder --win",
    "dist:mac": "npm run build:desktop && electron-builder --mac"
  },
  "build": {
    "appId": "com.han.zsb-study-tracker",
    "productName": "专升本学习助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!dist/screenshots/**"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "Han050912",
      "repo": "zsb-study-tracker"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/assets/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "专升本学习助手",
      "compression": "maximum"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/assets/logo.png",
      "category": "public.app-category.education"
    }
  },
  "dependencies": {
    "@lucide/vue": "^1.30.0",
    "cropperjs": "^1.6.2",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "katex": "^0.16.11",
    "markdown-it": "^15.0.0",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/cropperjs": "^1.1.5",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^9.1.0"
  }
}
